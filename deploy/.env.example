# --- Servidor por imagenes privadas (docker-compose.server.yml) ---
# Tu usuario de GitHub en minusculas (donde subiste las imagenes con publicar-imagenes.ps1).
IMAGE_OWNER=axelhb20
# La version a usar en el servidor. "latest" es la ultima que subiste; mejor fijar una, p. ej. v0.4.0.
IMAGE_TAG=latest

# Copia este archivo como deploy/.env en el servidor y completa los valores.
# Nunca subas deploy/.env al repositorio.

# Dominio que apunta a la IP del servidor (registro A). Con "localhost" sirve para probar en tu PC.
DOMAIN=demo.tudominio.pe

# Genera cada secreto con:  openssl rand -base64 36
POSTGRES_PASSWORD=
JWT_SECRET=
# Clave para cifrar el token del PSE (obligatoria sin simulación). Genera una con:
#   openssl rand -hex 32
# ⚠ NUNCA la cambies: si cambia, el token guardado ya no se puede leer y se corta la facturación.
BILLING_SECRET=
# Comprobantes simulados (sin valor tributario): desactivados en producción. Pon true solo en
# un servidor de pruebas; en el de la clínica, déjalo en false y configura el PSE (Mifact).
BILLING_ALLOW_SIMULATED=false

# Primer administrador (lo crea el seed)
SEED_CLINIC_NAME=Veterinaria Demo
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Clave con la que entran los usuarios de los datos de demostración (mínimo 10 caracteres)
DEMO_PASSWORD=

# Respaldo: contraseña que cifra los respaldos (openssl rand -base64 24). Anótala FUERA del
# servidor (hoja de entrega, gestor de contraseñas): sin ella no se puede restaurar nada.
BACKUP_PASSWORD=
# Cuánto historial se guarda: un respaldo por día y uno por mes. Lo demás se borra solo.
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# Destino fuera del servidor configurado en deploy/backup/rclone/rclone.conf, por ejemplo  gdrive:uywa-respaldos
RCLONE_REMOTE=
# Opcional, el primer mes: además, una copia completa diaria en el servidor cifrada con esta
# clave PÚBLICA de age (age1...). Se guardan 7 días. Déjalo vacío cuando ya no haga falta.
BACKUP_AGE_RECIPIENT=
# Aviso por correo si el respaldo falla o no corre: URL de un check en healthchecks.io (gratis)
BACKUP_PING_URL=
# Revisión semanal de rendimiento (lunes 07:10): otro check en healthchecks.io, período 7 días.
# Si algo está lento, el correo trae el informe. Lenta = más de PERF_SLOW_MS en promedio.
PERF_PING_URL=
PERF_SLOW_MS=300
