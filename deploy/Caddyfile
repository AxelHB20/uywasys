# Caddy: HTTPS con certificado gratuito (Let's Encrypt) que se renueva solo.
# DOMAIN sale del archivo .env (por ejemplo demo.uywa.pe). Con DOMAIN=localhost sirve en tu PC.

# La app completa (web + /api) apuntando a la API que se indica: "import app api:3000"
(app) {
	encode zstd gzip

	# La API: el backend no se expone a internet, solo Caddy lo alcanza
	handle /api/* {
		reverse_proxy {args[0]}
	}

	# La app de Angular: cualquier ruta que no sea un archivo carga index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Es la app privada de las clínicas: fuera de los buscadores (la página de venta irá aparte)
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Los archivos con huella en el nombre no cambian nunca; index.html siempre se revisa
	@hashed path_regexp [-.][A-Za-z0-9]{8,}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"
	@index path / /index.html
	header @index Cache-Control "no-cache"

	log {
		output stdout
		format console
	}
}

{$DOMAIN} {
	import app api:3000
}

# Sitios extra en el mismo servidor (por ejemplo el sistema de prueba): un archivo .caddy por sitio
# en ~/uywa/sites del servidor. Si la carpeta está vacía no pasa nada.
import /etc/caddy/sites/*.caddy
