# Finales de línea LF en el repositorio (evita que Windows marque todos los archivos como modificados)
* text=auto eol=lf
*.png binary
*.ico binary
*.woff2 binary
# Los scripts y configuraciones que corren dentro de contenedores Linux van siempre con fin de línea LF
*.sh text eol=lf
deploy/backup/crontab text eol=lf
deploy/Caddyfile text eol=lf
*.Dockerfile text eol=lf
Dockerfile text eol=lf
