# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000
# Coincide con docker-compose.yml de la raíz del proyecto
DATABASE_URL=postgresql://uywasys:uywasys@localhost:5432/uywasys
CORS_ORIGIN=http://localhost:4200

# Sesión: cambia JWT_SECRET por un texto largo y aleatorio (mínimo 32 caracteres).
# En producción usa uno distinto y COOKIE_SECURE=true (requiere HTTPS).
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas
SESSION_HOURS=8
COOKIE_SECURE=false

# Primer administrador (lo crea: npx prisma db seed)
SEED_CLINIC_NAME=Veterinaria Demo
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@uywa.pe
SEED_ADMIN_PASSWORD=CambiaEstaClave123
