// Esquema de base de datos de UywaSys.
// Regla multi-clínica: toda tabla de negocio lleva clinic_id.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VET
  RECEPTION
  GROOMER
  CASHIER
}

model Clinic {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(120)
  ruc                String?   @db.Char(11)
  address            String?   @db.VarChar(200)
  phone              String?   @db.VarChar(20)
  email              String?   @db.VarChar(120)
  /// Logo guardado en la base (máx. 1 MB): entra en los respaldos y no depende del disco del servidor
  logo               Bytes?    @db.ByteA
  logoMime           String?   @map("logo_mime") @db.VarChar(20)
  logoUpdatedAt      DateTime? @map("logo_updated_at") @db.Timestamptz(3)
  timezone           String    @default("America/Lima") @db.VarChar(40)
  /// Descuento máximo por línea (%) que puede dar el personal; por encima, solo el administrador
  maxDiscountPercent Decimal   @default(10) @map("max_discount_percent") @db.Decimal(5, 2)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            User[]
  auditLogs        AuditLog[]
  clients          Client[]
  authorizedPeople AuthorizedPerson[]
  pets             Pet[]
  queueEntries     QueueEntry[]
  products         Product[]
  presentations    ProductPresentation[]
  batches          ProductBatch[]
  stockMovements   StockMovement[]
  careServices     CareService[]
  sequences        ClinicSequence[]
  visits           Visit[]
  visitAddenda     VisitAddendum[]
  charges          Charge[]
  stockShortages   StockShortage[]
  cashRegisters    CashRegister[]
  cashSessions     CashSession[]
  receipts         Receipt[]
  payments         Payment[]
  cashMovements    CashMovement[]

  @@map("clinics")
}

model User {
  id                  Int       @id @default(autoincrement())
  clinicId            Int       @map("clinic_id")
  fullName            String    @map("full_name") @db.VarChar(120)
  email               String    @unique @db.VarChar(120)
  passwordHash        String    @map("password_hash") @db.VarChar(100)
  role                Role
  /// Número de colegiatura (CMVP) para veterinarios: se imprime en recetas
  licenseNumber       String?   @map("license_number") @db.VarChar(20)
  active              Boolean   @default(true)
  /// true cuando el usuario entra con una clave temporal: debe cambiarla antes de usar el sistema
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic          Clinic          @relation(fields: [clinicId], references: [id])
  auditLogs       AuditLog[]
  queueCreated    QueueEntry[]    @relation("QueueCreatedBy")
  queueAttended   QueueEntry[]    @relation("QueueAttendedBy")
  batchesReceived ProductBatch[]
  stockMovements  StockMovement[] @relation("MovementUser")
  movementsAsVet  StockMovement[] @relation("MovementVet")
  visitsAttended  Visit[]         @relation("VisitAttendedBy")
  visitsClosed    Visit[]         @relation("VisitClosedBy")
  visitAddenda    VisitAddendum[]
  chargesCreated  Charge[]        @relation("ChargeCreatedBy")
  chargesVoided   Charge[]        @relation("ChargeVoidedBy")
  chargesAsVet    Charge[]        @relation("ChargeVet")
  shortagesClosed StockShortage[]
  sessionsOpened  CashSession[]   @relation("SessionOpenedBy")
  sessionsClosed  CashSession[]   @relation("SessionClosedBy")
  receiptsCreated Receipt[]       @relation("ReceiptCreatedBy")
  receiptsVoided  Receipt[]       @relation("ReceiptVoidedBy")
  cashMovements   CashMovement[]  @relation("CashMovementBy")
  cashVoided      CashMovement[]  @relation("CashMovementVoidedBy")

  @@index([clinicId])
  @@map("users")
}

/// Bitácora: quién hizo qué, cuándo y sobre qué registro. Nunca se edita ni se borra.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  clinicId  Int      @map("clinic_id")
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.VarChar(40)
  data      Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([clinicId, createdAt])
  @@map("audit_logs")
}

// ─── Fase 1: clientes, mascotas y cola del día ───────────────────────────────

/// Catálogo 06 de SUNAT: DNI (1), carné de extranjería (4), RUC (6), pasaporte (7)
enum DocumentType {
  DNI
  CE
  RUC
  PASSPORT
}

enum Species {
  DOG
  CAT
  RABBIT
  GUINEA_PIG
  BIRD
  REPTILE
  OTHER
}

enum PetSex {
  MALE
  FEMALE
}

enum VisitType {
  CONSULTATION
  GROOMING
}

enum QueueStatus {
  ARRIVED
  WAITING
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Correlativos visibles por clínica (clientes, historias clínicas, tickets y luego series SUNAT).
/// Se toman con un UPDATE atómico dentro de la transacción del registro: sin huecos ni repetidos.
model ClinicSequence {
  clinicId  Int    @map("clinic_id")
  key       String @db.VarChar(30)
  lastValue Int    @default(0) @map("last_value")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@id([clinicId, key])
  @@map("clinic_sequences")
}

/// Dueño de una o más mascotas. Sin documento se permite (docType y docNumber nulos).
model Client {
  id               Int           @id @default(autoincrement())
  clinicId         Int           @map("clinic_id")
  /// Correlativo dentro de la clínica (C-00012); lo asigna ClinicSequence
  number           Int
  docType          DocumentType? @map("doc_type")
  docNumber        String?       @map("doc_number") @db.VarChar(12)
  /// Nombres y apellidos, o razón social si es RUC
  name             String        @db.VarChar(150)
  /// Celular peruano: 9 dígitos que empiezan con 9
  phone            String        @db.Char(9)
  email            String?       @db.VarChar(120)
  address          String?       @db.VarChar(200)
  district         String?       @db.VarChar(60)
  notes            String?       @db.VarChar(500)
  /// Ley 29733: consentimiento para tratar sus datos (obligatorio al registrar)
  consentAt        DateTime      @map("consent_at") @db.Timestamptz(3)
  consentVersion   String        @map("consent_version") @db.VarChar(20)
  /// FORM = lo marcó recepción con el cliente presente · IMPORT = la clínica declaró tenerlo al importar
  consentChannel   String        @map("consent_channel") @db.VarChar(10)
  consentById      Int?          @map("consent_by_id")
  /// Consentimiento aparte para promociones y recordatorios comerciales (opcional)
  marketingConsent Boolean       @default(false) @map("marketing_consent")
  /// Nombre, documento y celular normalizados (minúsculas, sin tildes) para buscar
  searchText       String        @map("search_text") @db.VarChar(200)
  active           Boolean       @default(true)
  /// "Cliente varios" (C-00000) para ventas de mostrador anónimas: no aparece en listas ni cifras
  walkIn           Boolean       @default(false) @map("walk_in")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic     Clinic             @relation(fields: [clinicId], references: [id])
  pets       Pet[]
  authorized AuthorizedPerson[]
  visits     Visit[]
  charges    Charge[]
  receipts   Receipt[]

  @@unique([clinicId, docType, docNumber])
  @@unique([clinicId, number])
  @@index([clinicId, name])
  @@map("clients")
}

/// Persona autorizada por el dueño para dejar o recoger a sus mascotas
model AuthorizedPerson {
  id        Int      @id @default(autoincrement())
  clinicId  Int      @map("clinic_id")
  clientId  Int      @map("client_id")
  name      String   @db.VarChar(120)
  dni       String?  @db.Char(8)
  phone     String?  @db.Char(9)
  relation  String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id])
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("authorized_people")
}

model Pet {
  id                 Int       @id @default(autoincrement())
  clinicId           Int       @map("clinic_id")
  /// Correlativo de historia clínica dentro de la clínica (HC-00045)
  number             Int
  clientId           Int       @map("client_id")
  name               String    @db.VarChar(60)
  /// Nombre normalizado para buscar
  nameSearch         String    @map("name_search") @db.VarChar(60)
  species            Species
  breed              String?   @db.VarChar(60)
  sex                PetSex?
  neutered           Boolean   @default(false)
  birthDate          DateTime? @map("birth_date") @db.Date
  /// true cuando la fecha se calculó desde una edad aproximada
  birthDateEstimated Boolean   @default(false) @map("birth_date_estimated")
  weightKg           Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  color              String?   @db.VarChar(40)
  microchip          String?   @db.VarChar(20)
  allergies          String?   @db.VarChar(300)
  aggressive         Boolean   @default(false)
  aggressiveNote     String?   @map("aggressive_note") @db.VarChar(200)
  notes              String?   @db.VarChar(500)
  deceasedAt         DateTime? @map("deceased_at") @db.Date
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  client         Client          @relation(fields: [clientId], references: [id])
  queueEntries   QueueEntry[]
  stockMovements StockMovement[]
  visits         Visit[]
  charges        Charge[]

  @@unique([clinicId, number])
  /// clientId: cargar las mascotas de un cliente (ficha y lista) · clinicId+clientId: búsqueda por nombre de mascota
  @@index([clientId])
  @@index([clinicId, clientId])
  @@map("pets")
}

/// Cola del día: llegada → espera → atención → atendido
model QueueEntry {
  id           Int         @id @default(autoincrement())
  clinicId     Int         @map("clinic_id")
  petId        Int         @map("pet_id")
  /// Día de la clínica (zona horaria de la clínica), para listar la cola de hoy
  day          DateTime    @db.Date
  type         VisitType   @default(CONSULTATION)
  status       QueueStatus @default(ARRIVED)
  urgent       Boolean     @default(false)
  reason       String?     @db.VarChar(200)
  arrivedAt    DateTime    @default(now()) @map("arrived_at") @db.Timestamptz(3)
  startedAt    DateTime?   @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?   @map("finished_at") @db.Timestamptz(3)
  createdById  Int         @map("created_by_id")
  attendedById Int?        @map("attended_by_id")
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic     Clinic  @relation(fields: [clinicId], references: [id])
  pet        Pet     @relation(fields: [petId], references: [id])
  createdBy  User    @relation("QueueCreatedBy", fields: [createdById], references: [id])
  attendedBy User?   @relation("QueueAttendedBy", fields: [attendedById], references: [id])
  visits     Visit[]

  @@index([clinicId, day])
  @@index([petId])
  @@map("queue_entries")
}

// ─── Fase 2: inventario farmacéutico y catálogo de servicios ─────────────────

enum ProductCategory {
  MEDICINE
  VACCINE
  ANTIPARASITIC
  FOOD
  ACCESSORY
  HYGIENE
  SUPPLY
}

/// Unidad mínima en la que se guarda el stock
enum BaseUnit {
  UNIT
  TABLET
  ML
  G
}

/// Afectación del IGV (SUNAT): 10 gravado, 20 exonerado, 30 inafecto
enum IgvAffectation {
  TAXED
  EXEMPT
  UNAFFECTED
}

enum MovementType {
  PURCHASE
  WASTE
  TREATMENT
  COUNT_ADJUST
  RETURN
  SALE
}

enum CareServiceCategory {
  CONSULTATION
  VACCINATION
  DEWORMING
  SURGERY
  LAB
  GROOMING
  OTHER
}

model Product {
  id                   Int             @id @default(autoincrement())
  clinicId             Int             @map("clinic_id")
  /// Código interno opcional (SKU)
  code                 String?         @db.VarChar(30)
  barcode              String?         @db.VarChar(30)
  name                 String          @db.VarChar(120)
  nameSearch           String          @map("name_search") @db.VarChar(120)
  category             ProductCategory
  baseUnit             BaseUnit        @map("base_unit")
  /// Alerta de stock bajo, en unidad mínima
  minStock             Decimal         @default(0) @map("min_stock") @db.Decimal(12, 3)
  requiresPrescription Boolean         @default(false) @map("requires_prescription")
  /// Medicamento controlado (ketamina y similares): cada salida guarda paciente, veterinario, lote y receta
  controlled           Boolean         @default(false)
  /// Unidad SUNAT para la boleta (NIU, KGM, LTR…)
  sunatUnit            String          @default("NIU") @map("sunat_unit") @db.VarChar(3)
  igv                  IgvAffectation  @default(TAXED)
  /// Suma de los lotes; se actualiza en la misma transacción que los lotes
  totalStock           Decimal         @default(0) @map("total_stock") @db.Decimal(12, 3)
  notes                String?         @db.VarChar(500)
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic        Clinic                @relation(fields: [clinicId], references: [id])
  presentations ProductPresentation[]
  batches       ProductBatch[]
  movements     StockMovement[]
  usedIn        CareServiceSupply[]
  charges       Charge[]
  shortages     StockShortage[]

  @@unique([clinicId, code])
  @@index([clinicId, name])
  @@map("products")
}

/// Presentación de venta o compra: "Caja x 100" = 100 unidades mínimas
model ProductPresentation {
  id        Int      @id @default(autoincrement())
  clinicId  Int      @map("clinic_id")
  productId Int      @map("product_id")
  name      String   @db.VarChar(60)
  factor    Decimal  @db.Decimal(12, 3)
  /// Precio de venta con IGV incluido
  price     Decimal? @db.Decimal(10, 2)
  barcode   String?  @db.VarChar(30)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@unique([productId, name])
  @@map("product_presentations")
}

model ProductBatch {
  id              Int       @id @default(autoincrement())
  clinicId        Int       @map("clinic_id")
  productId       Int       @map("product_id")
  /// Nulo solo en accesorios
  lotNumber       String?   @map("lot_number") @db.VarChar(40)
  expiresAt       DateTime? @map("expires_at") @db.Date
  quantity        Decimal   @db.Decimal(12, 3)
  initialQuantity Decimal   @map("initial_quantity") @db.Decimal(12, 3)
  /// Costo por unidad mínima, sin redondear a céntimos
  unitCost        Decimal?  @map("unit_cost") @db.Decimal(12, 4)
  supplier        String?   @db.VarChar(120)
  /// N.º de factura o boleta de compra
  documentNumber  String?   @map("document_number") @db.VarChar(30)
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  createdById     Int       @map("created_by_id")

  clinic    Clinic          @relation(fields: [clinicId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  movements StockMovement[]

  /// FEFO: lotes de un producto ordenados por vencimiento
  @@index([productId, expiresAt])
  @@index([clinicId, expiresAt])
  @@map("product_batches")
}

/// Kardex: cada entrada o salida de stock, por lote. Nunca se edita ni se borra.
model StockMovement {
  id              BigInt       @id @default(autoincrement())
  clinicId        Int          @map("clinic_id")
  productId       Int          @map("product_id")
  batchId         Int?         @map("batch_id")
  type            MovementType
  /// Positivo entra, negativo sale (unidad mínima)
  quantity        Decimal      @db.Decimal(12, 3)
  /// Stock total del producto después del movimiento
  balanceAfter    Decimal      @map("balance_after") @db.Decimal(12, 3)
  reason          String?      @db.VarChar(200)
  userId          Int          @map("user_id")
  /// Paciente al que se aplicó (obligatorio en controlados)
  petId           Int?         @map("pet_id")
  vetId           Int?         @map("vet_id")
  prescriptionRef String?      @map("prescription_ref") @db.VarChar(60)
  /// Origen: venta, consulta… (fases siguientes)
  refType         String?      @map("ref_type") @db.VarChar(20)
  refId           Int?         @map("ref_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic  Clinic        @relation(fields: [clinicId], references: [id])
  product Product       @relation(fields: [productId], references: [id])
  batch   ProductBatch? @relation(fields: [batchId], references: [id])
  user    User          @relation("MovementUser", fields: [userId], references: [id])
  pet     Pet?          @relation(fields: [petId], references: [id])
  vet     User?         @relation("MovementVet", fields: [vetId], references: [id])

  @@index([productId, createdAt])
  @@index([clinicId, createdAt])
  @@index([batchId])
  @@index([petId])
  @@map("stock_movements")
}

/// Catálogo de servicios (consulta, vacunación, baño…). El cobro llega en la Fase 4.
model CareService {
  id          Int                 @id @default(autoincrement())
  clinicId    Int                 @map("clinic_id")
  name        String              @db.VarChar(120)
  category    CareServiceCategory
  /// Precio con IGV incluido
  price       Decimal             @db.Decimal(10, 2)
  igv         IgvAffectation      @default(TAXED)
  durationMin Int?                @map("duration_min")
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic   Clinic              @relation(fields: [clinicId], references: [id])
  supplies CareServiceSupply[]
  charges  Charge[]

  @@unique([clinicId, name])
  @@map("care_services")
}

/// Insumo que consume un servicio (en unidad mínima del producto)
model CareServiceSupply {
  serviceId Int     @map("service_id")
  productId Int     @map("product_id")
  quantity  Decimal @db.Decimal(12, 3)

  service CareService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@id([serviceId, productId])
  @@index([productId])
  @@map("care_service_supplies")
}

// ─── Fase 3: atención y cobro ────────────────────────────────────────────────

enum VisitStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ChargeKind {
  SERVICE
  PRODUCT
}

/// PAID llega con la caja (Fase 3, paso 2)
enum ChargeStatus {
  PENDING
  PAID
  VOID
}

/// Atención: todo lo que recibe una mascota en una visita. Cerrada, ya no se edita (solo adendas).
model Visit {
  id           Int         @id @default(autoincrement())
  clinicId     Int         @map("clinic_id")
  petId        Int         @map("pet_id")
  clientId     Int         @map("client_id")
  /// Entrada de la cola de la que salió, si vino por ahí
  queueEntryId Int?        @map("queue_entry_id")
  type         VisitType   @default(CONSULTATION)
  status       VisitStatus @default(OPEN)
  reason       String?     @db.VarChar(200)
  /// Peso de esa visita: forma el historial de peso y actualiza la ficha
  weightKg     Decimal?    @map("weight_kg") @db.Decimal(5, 2)
  temperatureC Decimal?    @map("temperature_c") @db.Decimal(4, 1)
  notes        String?     @db.Text
  attendedById Int         @map("attended_by_id")
  openedAt     DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime?   @map("closed_at") @db.Timestamptz(3)
  closedById   Int?        @map("closed_by_id")
  cancelReason String?     @map("cancel_reason") @db.VarChar(200)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic     Clinic          @relation(fields: [clinicId], references: [id])
  pet        Pet             @relation(fields: [petId], references: [id])
  client     Client          @relation(fields: [clientId], references: [id])
  queueEntry QueueEntry?     @relation(fields: [queueEntryId], references: [id])
  attendedBy User            @relation("VisitAttendedBy", fields: [attendedById], references: [id])
  closedBy   User?           @relation("VisitClosedBy", fields: [closedById], references: [id])
  charges    Charge[]
  addenda    VisitAddendum[]

  @@index([clinicId, status])
  @@index([petId, openedAt])
  @@index([clientId])
  @@index([queueEntryId])
  @@map("visits")
}

/// Corrección de una atención cerrada: se agrega, nunca se edita lo anterior.
model VisitAddendum {
  id        Int      @id @default(autoincrement())
  clinicId  Int      @map("clinic_id")
  visitId   Int      @map("visit_id")
  authorId  Int      @map("author_id")
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id])
  visit  Visit  @relation(fields: [visitId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([visitId])
  @@map("visit_addenda")
}

/// Cargo en la cuenta del cliente. Nombre, precio e IGV quedan congelados al registrarlo;
/// los montos son los que irán a la boleta (UBL 2.1) sin recalcular.
model Charge {
  id              Int            @id @default(autoincrement())
  clinicId        Int            @map("clinic_id")
  clientId        Int            @map("client_id")
  visitId         Int?           @map("visit_id")
  petId           Int?           @map("pet_id")
  kind            ChargeKind
  careServiceId   Int?           @map("care_service_id")
  productId       Int?           @map("product_id")
  presentationId  Int?           @map("presentation_id")
  description     String         @db.VarChar(200)
  /// En la presentación vendida (productos) o veces que se hizo (servicios)
  quantity        Decimal        @db.Decimal(12, 3)
  /// Precio unitario con IGV
  unitPrice       Decimal        @map("unit_price") @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  discountReason  String?        @map("discount_reason") @db.VarChar(120)
  igvAffectation  IgvAffectation @map("igv_affectation")
  igvRate         Decimal        @map("igv_rate") @db.Decimal(5, 4)
  /// Catálogo 03 de SUNAT: ZZ para servicios, NIU u otra para productos
  sunatUnit       String         @map("sunat_unit") @db.VarChar(3)
  /// Valor de venta (sin IGV) + IGV = total, siempre exacto al céntimo
  taxableAmount   Decimal        @map("taxable_amount") @db.Decimal(12, 2)
  igvAmount       Decimal        @map("igv_amount") @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  /// Lo cobrado hasta ahora (pagos parciales); PAID cuando llega al total
  paidAmount      Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2)
  /// Controlados: receta y veterinario responsable
  prescriptionRef String?        @map("prescription_ref") @db.VarChar(60)
  vetId           Int?           @map("vet_id")
  status          ChargeStatus   @default(PENDING)
  createdById     Int            @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedById      Int?           @map("voided_by_id")
  voidedAt        DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidReason      String?        @map("void_reason") @db.VarChar(200)

  clinic       Clinic               @relation(fields: [clinicId], references: [id])
  client       Client               @relation(fields: [clientId], references: [id])
  visit        Visit?               @relation(fields: [visitId], references: [id])
  pet          Pet?                 @relation(fields: [petId], references: [id])
  careService  CareService?         @relation(fields: [careServiceId], references: [id])
  product      Product?             @relation(fields: [productId], references: [id])
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id])
  vet          User?                @relation("ChargeVet", fields: [vetId], references: [id])
  createdBy    User                 @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  voidedBy     User?                @relation("ChargeVoidedBy", fields: [voidedById], references: [id])
  shortages    StockShortage[]
  allocations  PaymentAllocation[]

  @@index([clinicId, clientId, status])
  @@index([clinicId, createdAt])
  @@index([visitId])
  @@index([productId])
  @@index([careServiceId])
  @@map("charges")
}

/// Insumo que se usó en un servicio pero no figuraba en el stock: el administrador lo cuadra.
model StockShortage {
  id           Int       @id @default(autoincrement())
  clinicId     Int       @map("clinic_id")
  chargeId     Int       @map("charge_id")
  productId    Int       @map("product_id")
  /// Unidades mínimas que faltaron
  quantity     Decimal   @db.Decimal(12, 3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById Int?      @map("resolved_by_id")
  resolution   String?   @db.VarChar(200)

  clinic     Clinic  @relation(fields: [clinicId], references: [id])
  charge     Charge  @relation(fields: [chargeId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  resolvedBy User?   @relation(fields: [resolvedById], references: [id])

  @@index([clinicId, resolvedAt])
  @@index([chargeId])
  @@index([productId])
  @@map("stock_shortages")
}

// ─── Fase 3, paso 2: caja ────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  YAPE
  PLIN
  CARD
  TRANSFER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum ReceiptStatus {
  ACTIVE
  VOID
}

/// EXPENSE = egreso de caja chica · REFUND = devolución al anular un cobro
enum CashMovementKind {
  EXPENSE
  REFUND
}

/// Caja física. Cada clínica empieza con "Caja principal"; puede tener más.
model CashRegister {
  id        Int      @id @default(autoincrement())
  clinicId  Int      @map("clinic_id")
  name      String   @db.VarChar(60)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic   Clinic        @relation(fields: [clinicId], references: [id])
  sessions CashSession[]

  @@unique([clinicId, name])
  @@map("cash_registers")
}

/// Turno de una caja: de la apertura al cierre con arqueo. Una sola abierta por caja.
model CashSession {
  id            Int               @id @default(autoincrement())
  clinicId      Int               @map("clinic_id")
  registerId    Int               @map("register_id")
  status        CashSessionStatus @default(OPEN)
  openingAmount Decimal           @map("opening_amount") @db.Decimal(12, 2)
  openedById    Int               @map("opened_by_id")
  openedAt      DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById    Int?              @map("closed_by_id")
  closedAt      DateTime?         @map("closed_at") @db.Timestamptz(3)
  /// Efectivo que debía haber: inicial + cobros en efectivo − egresos − devoluciones
  expectedCash  Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  countedCash   Decimal?          @map("counted_cash") @db.Decimal(12, 2)
  difference    Decimal?          @db.Decimal(12, 2)
  closingNote   String?           @map("closing_note") @db.VarChar(200)

  clinic    Clinic         @relation(fields: [clinicId], references: [id])
  register  CashRegister   @relation(fields: [registerId], references: [id])
  openedBy  User           @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("SessionClosedBy", fields: [closedById], references: [id])
  receipts  Receipt[]
  movements CashMovement[]

  @@index([registerId, status])
  @@index([clinicId, openedAt])
  @@map("cash_sessions")
}

/// Cobro: ticket NV-000001. En la Fase 4 se le adjunta la boleta o factura electrónica.
model Receipt {
  id          Int           @id @default(autoincrement())
  clinicId    Int           @map("clinic_id")
  /// Correlativo de la clínica (NV-000001)
  number      Int
  clientId    Int           @map("client_id")
  sessionId   Int           @map("session_id")
  /// Lo aplicado a los cargos (la suma de los pagos)
  total       Decimal       @db.Decimal(12, 2)
  /// Vuelto entregado en efectivo
  change      Decimal       @default(0) @db.Decimal(12, 2)
  /// Clave que manda la pantalla: un reintento devuelve el mismo cobro
  requestKey  String        @map("request_key") @db.VarChar(64)
  status      ReceiptStatus @default(ACTIVE)
  createdById Int           @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedById  Int?          @map("voided_by_id")
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason  String?       @map("void_reason") @db.VarChar(200)

  clinic      Clinic              @relation(fields: [clinicId], references: [id])
  client      Client              @relation(fields: [clientId], references: [id])
  session     CashSession         @relation(fields: [sessionId], references: [id])
  createdBy   User                @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  voidedBy    User?               @relation("ReceiptVoidedBy", fields: [voidedById], references: [id])
  payments    Payment[]
  allocations PaymentAllocation[]
  refunds     CashMovement[]

  @@unique([clinicId, number])
  @@unique([clinicId, requestKey])
  @@index([sessionId])
  @@index([clientId])
  @@index([clinicId, createdAt])
  @@map("receipts")
}

/// Cada medio de pago dentro de un cobro (efectivo + Yape, por ejemplo).
model Payment {
  id            Int           @id @default(autoincrement())
  clinicId      Int           @map("clinic_id")
  receiptId     Int           @map("receipt_id")
  method        PaymentMethod
  /// Lo que se aplica a la deuda
  amount        Decimal       @db.Decimal(12, 2)
  /// Efectivo entregado por el cliente (para calcular el vuelto)
  tendered      Decimal?      @db.Decimal(12, 2)
  /// Código de operación de Yape, Plin o transferencia; voucher de tarjeta
  operationCode String?       @map("operation_code") @db.VarChar(40)

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  receipt Receipt @relation(fields: [receiptId], references: [id])

  @@index([receiptId])
  @@map("payments")
}

/// Qué parte del cobro cubre cada cargo.
model PaymentAllocation {
  id        Int     @id @default(autoincrement())
  receiptId Int     @map("receipt_id")
  chargeId  Int     @map("charge_id")
  amount    Decimal @db.Decimal(12, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id])
  charge  Charge  @relation(fields: [chargeId], references: [id])

  @@index([receiptId])
  @@index([chargeId])
  @@map("payment_allocations")
}

/// Salidas de dinero de una sesión: egresos de caja chica y devoluciones.
model CashMovement {
  id          Int              @id @default(autoincrement())
  clinicId    Int              @map("clinic_id")
  sessionId   Int              @map("session_id")
  kind        CashMovementKind
  /// Los egresos son siempre en efectivo; una devolución sale por el mismo medio del pago
  method      PaymentMethod    @default(CASH)
  amount      Decimal          @db.Decimal(12, 2)
  reason      String           @db.VarChar(200)
  receiptId   Int?             @map("receipt_id")
  createdById Int              @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedById  Int?             @map("voided_by_id")
  voidedAt    DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidReason  String?          @map("void_reason") @db.VarChar(200)

  clinic    Clinic      @relation(fields: [clinicId], references: [id])
  session   CashSession @relation(fields: [sessionId], references: [id])
  receipt   Receipt?    @relation(fields: [receiptId], references: [id])
  createdBy User        @relation("CashMovementBy", fields: [createdById], references: [id])
  voidedBy  User?       @relation("CashMovementVoidedBy", fields: [voidedById], references: [id])

  @@index([sessionId])
  @@index([receiptId])
  @@map("cash_movements")
}
